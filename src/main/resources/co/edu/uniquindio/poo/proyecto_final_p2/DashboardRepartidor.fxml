<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.poo.proyecto_final_p2.controller.DashboardRepartidorController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: #f8f9fa;">

    <!-- Panel lateral izquierdo -->
    <VBox layoutX="0" layoutY="0" prefWidth="180" prefHeight="400" spacing="12"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #dee2e6; -fx-border-width: 0 1 0 0;">

        <Label text="Menú Repartidor"
               style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #212529;" />

        <Button fx:id="btnConsultarEnvios" text="Consultar envíos asignados" maxWidth="160"
                style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-font-size: 14px; -fx-cursor: hand;" />

        <Button fx:id="btnCambiarDisponibilidad" text="Cambiar disponibilidad" maxWidth="160"
                style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-font-size: 14px; -fx-cursor: hand;" />
    </VBox>

    <!-- Área principal -->
    <VBox fx:id="contentArea" layoutX="200" layoutY="20" prefWidth="380" prefHeight="360"
          AnchorPane.topAnchor="20" AnchorPane.leftAnchor="200"
          style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #ced4da; -fx-border-radius: 5; -fx-background-radius: 5;">

        <Label text="Seleccione una opción del menú" style="-fx-font-size: 18px; -fx-text-fill: #212529;" />

        <ComboBox fx:id="comboDisponibilidad" prefWidth="200" visible="false">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Activo" />
                    <String fx:value="Inactivo" />
                    <String fx:value="En ruta" />
                </FXCollections>
            </items>
        </ComboBox>

        <Button fx:id="btnGuardarDisponibilidad" text="Guardar Disponibilidad" prefWidth="200" visible="false"
                style="-fx-background-color: #0d6efd; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

    </VBox>

</AnchorPane>
