<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="504.0" prefWidth="718.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyecto_final_p2.controller.DashboardUsuarioController">

    <!-- Panel lateral izquierdo -->
    <VBox layoutX="0" layoutY="0" prefHeight="400" prefWidth="180" spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #dee2e6; -fx-border-width: 0 1 0 0;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0">

        <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #212529;" text="Menú de Usuario" />

        <Button fx:id="btnSolicitarEnvio" maxWidth="160" style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-font-size: 14px; -fx-cursor: hand;" text="Solicitar envío" />

        <Button fx:id="btnConsultarEnvio" maxWidth="160" style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-font-size: 14px; -fx-cursor: hand;" text="Consultar envío" />

        <Button fx:id="btnActualizarDireccion" maxWidth="160" style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-font-size: 14px; -fx-cursor: hand;" text="Actualizar dirección" />
    </VBox>

    <!-- Área principal donde cargaremos el contenido dinámico -->
    <VBox fx:id="contentArea" layoutX="200" layoutY="20" prefHeight="470.0" prefWidth="503.0" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #ced4da; -fx-border-radius: 5; -fx-background-radius: 5;" AnchorPane.leftAnchor="200" AnchorPane.topAnchor="20">
        <Label style="-fx-font-size: 20px; -fx-text-fill: #212529;" text="Bienvenido al Dashboard" />
    </VBox>

</AnchorPane>


