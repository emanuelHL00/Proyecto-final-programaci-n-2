<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.poo.proyecto_final_p2.controller.DashboardAdminController"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #f8f9fa;">

    <VBox layoutX="0" layoutY="0" prefWidth="200" prefHeight="600" spacing="12"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          style="-fx-background-color: #2c3e50; -fx-padding: 20; -fx-border-color: #34495e; -fx-border-width: 0 2 0 0;">

        <Label text="Menú Administrador"
               style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #ecf0f1; -fx-padding: 0 0 10 0;" />

        <Separator style="-fx-background-color: #34495e;" />

        <Button fx:id="btnGestionUsuarios" text="Gestión de Usuarios" maxWidth="180"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 10; -fx-background-radius: 5;" />

        <Button fx:id="btnGestionRepartidores" text="Gestión de Repartidores" maxWidth="180"
                style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 10; -fx-background-radius: 5;" />

        <Button fx:id="btnAsignarEnvios" text="Gestión de Envíos" maxWidth="180"
                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 10; -fx-background-radius: 5;" />
    </VBox>

    <ScrollPane layoutX="220" layoutY="20" prefWidth="660" prefHeight="560"
                AnchorPane.topAnchor="20" AnchorPane.leftAnchor="220" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20"
                style="-fx-background: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5;"
                fitToWidth="true">
        <VBox fx:id="contentArea" style="-fx-background-color: white; -fx-padding: 20;">
            <Label text="Bienvenido al Panel de Administrador"
                   style="-fx-font-size: 24px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;" />
            <Label text="Seleccione una opción del menú lateral"
                   style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d; -fx-padding: 10 0 0 0;" />
        </VBox>
    </ScrollPane>

</AnchorPane>

